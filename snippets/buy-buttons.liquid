{% comment %}
  High-Converting Buy Buttons for LUXEN (COD)
{% endcomment %}
<div {{ block.shopify_attributes }}>
  {%- if product != blank -%}
    <product-form class="product-form" data-section-id="{{ section.id }}">
      <div class="product-form__error-message-wrapper" role="alert" hidden>
        <span class="product-form__error-message"></span>
      </div>

      {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" class="product-variant-id">
        <input type="hidden" name="quantity" value="1">

        <!-- Urgencia Superior -->
        <div class="lxn-urgency-badge">
          🔥 Oferta por tiempo limitado - 50% DCTO
        </div>

        <div class="product-form__buttons">
          <!-- Botón de Acción Principal Forzado (Siempre Activo para COD) -->
                    <button
            id="ProductSubmitButton-{{ section_id }}"
            type="submit"
            name="add"
            class="product-form__submit lxn-giant-cta"
          >
            👉 PEDIR CONTRA ENTREGA - {{ product.price | money }}
            {%- render 'loading-spinner' -%}
          </button>
        </div>
        
        <!-- Contador de Stock -->
        <div class="lxn-stock-counter">
          ⚠️ Solo quedan <strong class="stock-random">7</strong> unidades disponibles
        </div>

                <div class="lxn-cta-subtitle">
          🛡️ Garantía de Devolución | Pagas en Efectivo al Recibir en Casa
        </div>
          <div class="lxn-benefit-item">
            <span class="lxn-benefit-icon">💵</span>
            <span class="lxn-benefit-text">Pagas en efectivo al recibir en tu puerta</span>
          </div>
          <div class="lxn-benefit-item">
            <span class="lxn-benefit-icon">🔒</span>
            <span class="lxn-benefit-text">Garantía de satisfacción 100%</span>
          </div>
        </div>

      {%- endform -%}
    </product-form>
  {%- endif -%}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const stockEl = document.querySelector('.stock-random');
    if(stockEl) {
            stockEl.innerText = Math.floor(Math.random() * (12 - 3 + 1) + 3);
    }
    const viewersEl = document.querySelector('.viewers-random');
    if(viewersEl) {
      setInterval(() => {
        viewersEl.innerText = Math.floor(Math.random() * (45 - 15 + 1) + 15);
      }, 5000);
    }

    // Sticky CTA logic
    const cta = document.querySelector('.lxn-giant-cta');
    if(cta && window.innerWidth < 768) {
      window.addEventListener('scroll', () => {
        const rect = cta.parentElement.getBoundingClientRect();
        if(rect.bottom < 0) {
          cta.classList.add('lxn-sticky-mobile');
        } else {
          cta.classList.remove('lxn-sticky-mobile');
        }
      });
    }
  });
</script>

<style>
.lxn-urgency-badge {
  background-color: #FEF2F2;
  color: #DC2626;
  font-weight: 800;
  text-align: center;
  padding: 10px;
  border-radius: 8px;
  margin-bottom: 15px;
  border: 1px dashed #F87171;
  font-size: 15px;
}

.lxn-giant-cta { animation: lxn-pulse 2s infinite; 
  width: 100%;
  background-color: #E5A93C !important;
  color: #000000 !important;
  font-size: 15px !important;
  font-weight: 900 !important;
  padding: 18px 10px !important;
  border-radius: 12px !important;
  border: none !important;
  box-shadow: 0 8px 20px rgba(229,169,60,0.4) !important;
  cursor: pointer;
  transition: all 0.3s ease !important;
  text-transform: uppercase;
  display: flex;
  justify-content: center;
  align-items: center;
  white-space: normal;
  line-height: 1.2;
}

.lxn-giant-cta:hover {
  transform: translateY(-3px) scale(1.02) !important;
  box-shadow: 0 12px 25px rgba(229,169,60,0.5) !important;
  background-color: #d4952b !important;
}

.lxn-stock-counter {
  margin-top: 15px;
  text-align: center;
  font-size: 15px;
  font-weight: 600;
  color: #B45309;
  background: #FFFBEB;
  padding: 8px;
  border-radius: 6px;
}

.lxn-benefits-strip {
  margin-top: 25px;
  background: #F8FAFC;
  border: 1px solid #E2E8F0;
  border-radius: 12px;
  padding: 16px;
}

.lxn-benefit-item {
  display: flex;
  align-items: center;
  margin-bottom: 12px;
}

.lxn-benefit-item:last-child {
  margin-bottom: 0;
}

.lxn-benefit-icon {
  font-size: 22px;
  margin-right: 12px;
}

.lxn-benefit-text {
  font-size: 14px;
  font-weight: 600;
  color: #1E293B;
  line-height: 1.3;
}
@keyframes lxn-pulse {
  0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(229,169,60,0.7); }
  70% { transform: scale(1.03); box-shadow: 0 0 0 15px rgba(229,169,60,0); }
  100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(229,169,60,0); }
}
.lxn-live-viewers {
  margin-top: 20px;
  text-align: center;
  font-size: 14px;
  color: #475569;
  display: flex;
  justify-content: center;
  align-items: center;
}
.lxn-live-dot {
  width: 8px; height: 8px;
  background-color: #EF4444;
  border-radius: 50%;
  margin-right: 8px;
  animation: blink 1.5s infinite;
}
@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

.lxn-stock-progress-wrap {
  margin-top: 15px;
  background: #FFFBEB;
  padding: 12px;
  border-radius: 8px;
  border: 1px solid #FEF3C7;
}
.lxn-stock-text {
  text-align: center;
  font-size: 14px;
  font-weight: 700;
  color: #B45309;
  margin-bottom: 8px;
}
.lxn-stock-bar {
  width: 100%;
  height: 8px;
  background-color: #FDE68A;
  border-radius: 4px;
  overflow: hidden;
}
.lxn-stock-bar-fill {
  width: 12%;
  height: 100%;
  background-color: #DC2626;
  border-radius: 4px;
}

/* Sticky Mobile Button */
@media screen and (max-width: 768px) {
  .lxn-sticky-mobile {
    position: fixed !important;
    bottom: 15px !important;
    left: 5% !important;
    width: 90% !important;
    z-index: 9999 !important;
    box-shadow: 0 -4px 20px rgba(0,0,0,0.15) !important;
  }
}
.lxn-cta-subtitle {
  text-align: center;
  font-size: 13px;
  font-weight: 700;
  color: #475569;
  margin-top: 12px;
}
</style>


