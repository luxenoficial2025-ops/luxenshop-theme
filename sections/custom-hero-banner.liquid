{%- style -%}
  .lxn-hero-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  @media screen and (min-width: 768px) {
    .lxn-hero-{{ section.id }} {
      padding-left: 24px;
      padding-right: 24px;
    }
  }

  /* Outer wrapper with rounded corners */
  .lxn-hero-track-wrap-{{ section.id }} {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    border-radius: {{ section.settings.border_radius }}px;
    overflow: hidden;
    box-shadow: 0 6px 24px rgba(15,93,90,.1);
  }

  /* Slides strip */
  .lxn-hero-track-{{ section.id }} {
    display: flex;
    transition: transform .5s cubic-bezier(.4,0,.2,1);
    will-change: transform;
  }

  /* Individual slide */
  .lxn-hero-slide-{{ section.id }} {
    flex: 0 0 100%;
    width: 100%;
    min-height: {{ section.settings.height_mobile }}px;
    position: relative;
    display: flex;
    align-items: center;
  }

  @media screen and (min-width: 768px) {
    .lxn-hero-slide-{{ section.id }} {
      min-height: {{ section.settings.height_desktop }}px;
    }
  }

  /* Background image */
  .lxn-hero-img-wrap {
    position: absolute;
    inset: 0;
  }
  .lxn-hero-img-wrap img {
    width: 100%; height: 100%; object-fit: cover; object-position: center;
  }
  .lxn-hero-placeholder {
    width: 100%; height: 100%;
    background: linear-gradient(135deg, #0F5D5A 0%, #1E88E5 100%);
  }

  /* Overlay */
  .lxn-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(15,30,26,.65) 0%, rgba(15,30,26,.1) 100%);
  }

  /* Content */
  .lxn-hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 32px 24px;
    color: #fff;
    box-sizing: border-box;
  }

  .lxn-hero-content-left  { max-width: 520px; text-align: left; }
  .lxn-hero-content-center { max-width: 620px; margin: 0 auto; text-align: center; }
  .lxn-hero-content-right  { max-width: 520px; margin-left: auto; text-align: right; }

  .lxn-hero-heading {
    font-size: 24px;
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 10px;
    text-shadow: 0 2px 8px rgba(0,0,0,.3);
  }

  @media screen and (min-width: 768px) {
    .lxn-hero-heading { font-size: 42px; }
  }

  .lxn-hero-sub {
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
    margin: 0 0 22px;
    color: rgba(244,249,248,.9);
    text-shadow: 0 1px 4px rgba(0,0,0,.3);
  }

  @media screen and (min-width: 768px) {
    .lxn-hero-sub { font-size: 17px; }
  }

  .lxn-hero-cta {
    display: inline-block;
    background-color: {{ section.settings.cta_color }};
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: 14px;
    padding: 12px 28px;
    border-radius: 50px;
    box-shadow: 0 4px 14px rgba(255,122,89,.35);
    transition: all .25s ease;
  }

  .lxn-hero-cta:hover {
    background-color: #e56b4c;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(255,122,89,.45);
  }

  /* Dot navigation */
  .lxn-hero-dots-{{ section.id }} {
    position: absolute;
    bottom: 16px;
    left: 0; right: 0;
    display: flex;
    justify-content: center;
    gap: 8px;
    z-index: 3;
  }

  .lxn-hero-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    border: none;
    background: rgba(255,255,255,.45);
    cursor: pointer;
    padding: 0;
    transition: all .25s ease;
  }

  .lxn-hero-dot.is-active {
    width: 24px;
    border-radius: 4px;
    background: {{ section.settings.cta_color }};
  }
{%- endstyle -%}

<div class="lxn-hero-{{ section.id }}" id="lxn-hero-{{ section.id }}">
  <div
    class="lxn-hero-track-wrap-{{ section.id }}"
    data-autoplay="{{ section.settings.autoplay }}"
    data-interval="{{ section.settings.autoplay_interval | times: 1000 }}"
  >
    <div class="lxn-hero-track-{{ section.id }}" id="lxn-track-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div class="lxn-hero-slide-{{ section.id }}" {{ block.shopify_attributes }}>
          <div class="lxn-hero-img-wrap">
            {%- if block.settings.image_desktop != blank -%}
              <picture>
                {%- if block.settings.image_mobile != blank -%}
                  <source media="(max-width:767px)" srcset="{{ block.settings.image_mobile | image_url: width: 800 }}">
                {%- endif -%}
                <img
                  src="{{ block.settings.image_desktop | image_url: width: 1600 }}"
                  alt="{{ block.settings.image_desktop.alt | default: block.settings.heading | escape }}"
                  {% if forloop.first %}fetchpriority="high" loading="eager"{% else %}fetchpriority="low" loading="lazy"{% endif %}
                  width="{{ block.settings.image_desktop.width }}"
                  height="{{ block.settings.image_desktop.height }}"
                >
              </picture>
            {%- else -%}
              <div class="lxn-hero-placeholder"></div>
            {%- endif -%}
          </div>

          <div class="lxn-hero-overlay"></div>

          <div class="lxn-hero-content lxn-hero-content-{{ block.settings.text_alignment }}">
            {%- if block.settings.heading != blank -%}
              <h2 class="lxn-hero-heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.subheading != blank -%}
              <p class="lxn-hero-sub">{{ block.settings.subheading | escape }}</p>
            {%- endif -%}
            {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
              <a href="{{ block.settings.button_link }}" class="lxn-hero-cta">
                {{ block.settings.button_label | escape }}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="lxn-hero-dots-{{ section.id }}" id="lxn-dots-{{ section.id }}">
        {%- for block in section.blocks -%}
          <button
            class="lxn-hero-dot{% if forloop.first %} is-active{% endif %}"
            data-i="{{ forloop.index0 }}"
            aria-label="Diapositiva {{ forloop.index }}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
(function(){
  var id        = '{{ section.id }}';
  var wrap      = document.querySelector('.lxn-hero-track-wrap-' + id);
  if (!wrap) return;

  var track     = document.getElementById('lxn-track-' + id);
  var dotsWrap  = document.getElementById('lxn-dots-' + id);
  var slides    = track ? track.querySelectorAll('.lxn-hero-slide-' + id) : [];
  var dots      = dotsWrap ? dotsWrap.querySelectorAll('.lxn-hero-dot') : [];
  var total     = slides.length;

  if (total <= 1) return;

  var current   = 0;
  var autoplay  = wrap.getAttribute('data-autoplay') === 'true';
  var interval  = parseInt(wrap.getAttribute('data-interval')) || 5000;
  var timer     = null;

  function goTo(n) {
    if (n < 0) n = total - 1;
    if (n >= total) n = 0;
    current = n;
    track.style.transform = 'translateX(-' + (current * 100) + '%)';
    dots.forEach(function(d, i){ d.classList.toggle('is-active', i === current); });
  }

  dots.forEach(function(d){
    d.addEventListener('click', function(){
      goTo(parseInt(this.getAttribute('data-i')));
      if (autoplay) startTimer();
    });
  });

  // Touch swipe
  var sx = 0;
  wrap.addEventListener('touchstart', function(e){ sx = e.touches[0].clientX; stopTimer(); }, {passive:true});
  wrap.addEventListener('touchend', function(e){
    var dx = e.changedTouches[0].clientX - sx;
    if (Math.abs(dx) > 45) goTo(dx < 0 ? current + 1 : current - 1);
    if (autoplay) startTimer();
  }, {passive:true});

  function tick() { goTo(current + 1); }
  function startTimer() { stopTimer(); timer = setInterval(tick, interval); }
  function stopTimer() { if (timer) clearInterval(timer); }

  if (autoplay) {
    startTimer();
    document.addEventListener('visibilitychange', function(){
      document.hidden ? stopTimer() : startTimer();
    });
  }
})();
</script>

{% schema %}
{
  "name": "Custom Hero Slideshow",
  "class": "custom-hero-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Rotar automáticamente",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Tiempo de rotación",
      "default": 5
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 200,
      "max": 600,
      "step": 20,
      "unit": "px",
      "label": "Altura en Móvil",
      "default": 320
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 300,
      "max": 700,
      "step": 20,
      "unit": "px",
      "label": "Altura en Escritorio",
      "default": 480
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Radio de esquinas del Banner",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Relleno superior",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Relleno inferior",
      "default": 0
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo de la sección",
      "default": "#F4F9F8"
    },
    {
      "type": "color",
      "id": "cta_color",
      "label": "Color del Botón CTA y Dots",
      "default": "#FF7A59"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Diapositiva",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Imagen Escritorio",
          "info": "Recomendado: 1600×560px"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Imagen Móvil (Opcional)",
          "info": "Recomendado: 800×700px"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Alivio y bienestar diario"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subtítulo",
          "default": "Envío rápido a todo el país con pago contra entrega."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto del botón",
          "default": "Ver Productos"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Enlace del botón"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Alineación del texto",
          "options": [
            { "value": "left",   "label": "Izquierda" },
            { "value": "center", "label": "Centro" },
            { "value": "right",  "label": "Derecha" }
          ],
          "default": "left"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Hero Slideshow",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "heading": "Alivio y bienestar diario",
            "subheading": "Soluciones clínicamente probadas con envío rápido y pago contra entrega.",
            "button_label": "Ver Productos",
            "text_alignment": "left"
          }
        }
      ]
    }
  ]
}
{% endschema %}
