<div class="cro-testimonials" style="background-color: {{ section.settings.bg_color }};">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="cro-testimonials__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    
    <div class="cro-testimonials__grid grid grid--1-col grid--3-col-tablet">
      {%- for block in section.blocks -%}
        <div class="cro-testimonial-card grid__item" {{ block.shopify_attributes }}>
          <div class="cro-testimonial__header">
            <div class="cro-testimonial__stars">
              {%- for i in (1..5) -%}
                <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
              {%- endfor -%}
            </div>
            {%- if block.settings.verified -%}
              <span class="cro-testimonial__verified">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                Compra Verificada
              </span>
            {%- endif -%}
          </div>
          
          <p class="cro-testimonial__text">"{{ block.settings.text | escape }}"</p>
          
          <div class="cro-testimonial__author-box">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 60, height: 60, crop: 'center' }}" 
                   class="cro-testimonial__avatar" 
                   alt="{{ block.settings.author | escape }}" 
                   loading="lazy">
            {%- else -%}
              <div class="cro-testimonial__avatar-placeholder">
                {{ block.settings.author | slice: 0 | upcase }}
              </div>
            {%- endif -%}
            <div class="cro-testimonial__author-info">
              <span class="cro-testimonial__author-name">{{ block.settings.author | escape }}</span>
              {%- if block.settings.location != blank -%}
                <span class="cro-testimonial__author-location">{{ block.settings.location | escape }}</span>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CRO Testimonios",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Clientes Felices"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#F9FAFB"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Testimonio",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto del cliente (Opcional)"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Nombre del cliente",
          "default": "María J."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Ciudad",
          "default": "Quito"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Comentario",
          "default": "Excelente producto, llegó rápido a mi casa."
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Mostrar Compra Verificada",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CRO Testimonios",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "author": "Carlos M.",
            "location": "Guayaquil",
            "text": "Compré con algo de desconfianza pero pagar al recibir me dio seguridad. Recomendados."
          }
        },
        {
          "type": "review",
          "settings": {
            "author": "Andrea S.",
            "location": "Quito",
            "text": "La calidad superó mis expectativas. El envío fue súper rápido mediante Servientrega."
          }
        },
        {
          "type": "review",
          "settings": {
            "author": "Luis V.",
            "location": "Cuenca",
            "text": "Me llegó todo en perfecto estado, definitivamente volveré a comprar aquí."
          }
        }
      ]
    }
  ]
}
{% endschema %}
