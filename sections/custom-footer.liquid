<style>
  .lxn-footer-wrapper {
    background-color: #000000;
    color: #D1D5DB;
    padding: 60px 20px 40px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  .lxn-footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  @media (min-width: 768px) {
    .lxn-footer-inner {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  /* Columna 1 */
  .lxn-footer-logo {
    max-width: 140px !important;
    height: auto;
    margin-bottom: 20px;
    display: block;
    mix-blend-mode: screen;
  }
  .lxn-footer-contact {
    margin-bottom: 20px;
    font-size: 14px;
    line-height: 1.6;
  }
  .lxn-footer-whatsapp-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #25D366;
    color: #ffffff;
    padding: 10px 20px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 800;
    font-size: 14px;
    transition: opacity 0.2s;
  }
  .lxn-footer-whatsapp-btn:hover {
    opacity: 0.9;
  }

  /* Columna 2 */
  .lxn-footer-title {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 800;
    margin-bottom: 20px;
    text-transform: uppercase;
  }
  .lxn-footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .lxn-footer-links li {
    margin-bottom: 12px;
  }
  .lxn-footer-links a {
    color: #D1D5DB;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s ease;
  }
  .lxn-footer-links a:hover {
    color: #E5A93C;
  }

  /* Columna 3 */
  .lxn-footer-badges {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .lxn-badge-item {
    background: #111827;
    border: 1px solid #374151;
    padding: 12px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Copyright */
  .lxn-footer-bottom {
    max-width: 1200px;
    margin: 40px auto 0;
    padding-top: 20px;
    border-top: 1px solid #1F2937;
    text-align: center;
    font-size: 12px;
    color: #6B7280;
  }
</style>

