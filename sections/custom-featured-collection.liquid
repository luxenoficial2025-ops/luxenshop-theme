{%- style -%}
  .custom-collection-wrap {
    background-color: #FFFFFF;
    padding: 50px 20px;
  }
  .section-title-premium {
    text-align: center;
    font-size: 26px;
    font-weight: 800;
    color: #0D0D0D;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 40px;
  }
  @media screen and (min-width: 768px) {
    .section-title-premium { font-size: 32px; }
  }
  .products-grid-premium {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
  }
  @media screen and (min-width: 768px) {
    .products-grid-premium {
      grid-template-columns: repeat(4, 1fr);
      gap: 25px;
    }
  }
{%- endstyle -%}

<div class="custom-collection-wrap">
  <h2 class="section-title-premium">PRODUCTOS DESTACADOS & TENDENCIAS</h2>
  <div class="products-grid-premium">
    {%- assign selected_collection = collections[section.settings.collection] -%}
    {%- assign products_to_show = section.settings.products_to_show | default: 4 -%}
    
    {%- if selected_collection != blank and selected_collection.products.size > 0 -%}
      {%- for product in selected_collection.products limit: products_to_show -%}
        {%- render 'custom-product-card', product: product, lazy_load: true -%}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..products_to_show) -%}
        <!-- Placeholder product card -->
        <div style="background: #fff; border: 1px solid #D4A24C; border-radius: 12px; padding: 15px; text-align:center; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
          <div style="height:200px; background:#f4f4f4; margin-bottom:15px; border-radius:8px;"></div>
          <h3 style="font-weight: 700; font-size:15px; color:#0D0D0D; margin-bottom:5px;">Producto de Lujo {{i}}</h3>
          <div style="color:#D4A24C; margin-bottom:10px;">★★★★★ <span style="color:#666; font-size:12px;">(4.9)</span></div>
          <div style="font-weight: 800; font-size:18px; margin-bottom:15px;">.99</div>
          <button style="width:100%; background:#D4A24C; color:#000; border:none; padding:12px; border-radius:6px; font-weight:800; cursor:pointer;">AÑADIR AL CARRITO</button>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Colección LUXEN Premium",
  "class": "lxn-section-collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 2,
      "default": 4,
      "label": "Productos a mostrar"
    }
  ]
}
{% endschema %}
