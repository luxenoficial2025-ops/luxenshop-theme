{%- if section.settings.show_trust_bar -%}
  <div class="cro-trust-bar" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
    <div class="cro-trust-bar__inner">
      {%- for block in section.blocks -%}
        <div class="cro-trust-bar__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <span class="cro-trust-bar__icon">{{ block.settings.icon }}</span>
          {%- endif -%}
          <span class="cro-trust-bar__text">{{ block.settings.text | escape }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
  
  {%- if section.blocks.size > 1 -%}
    <!-- Simple JS rotador para movil si hay mas de 1 bloque -->
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        if (window.innerWidth < 750) {
          const items = document.querySelectorAll('.cro-trust-bar__item');
          let current = 0;
          if (items.length > 1) {
            setInterval(() => {
              items.forEach(item => item.style.display = 'none');
              current = (current + 1) % items.length;
              items[current].style.display = 'flex';
            }, 3000);
          }
        }
      });
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "CRO Trust Bar",
  "max_blocks": 3,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_trust_bar",
      "label": "Mostrar Trust Bar",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#D4A24C"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Elemento de confianza",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icono (Emoji o SVG inline)",
          "default": "🚚"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Envío a todo Ecuador"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CRO Trust Bar",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "icon": "🚚",
            "text": "Envío a todo Ecuador"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "💵",
            "text": "Pago Contra Entrega"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "🛡️",
            "text": "Compra 100% Segura"
          }
        }
      ]
    }
  ]
}
{% endschema %}
