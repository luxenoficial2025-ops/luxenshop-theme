{%- style -%}
  :root {
    --hero-bg: #0D0D0D;
    --hero-gold: #D4A24C;
    --hero-text: #FFFFFF;
  }

  .lxn-hero-wrap {
    background-color: var(--hero-bg);
    /* Sutil textura o degradado imitando luz focal */
    background-image: radial-gradient(circle at center, #1a1a1a 0%, #0D0D0D 80%);
    position: relative;
    overflow: hidden;
    padding: 60px 20px;
  }

  .lxn-hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
    position: relative;
    z-index: 2;
  }

  /* Text Content */
  .lxn-hero-text-content {
    text-align: center;
    max-width: 600px;
    flex: 1;
  }

  .lxn-hero-stars {
    color: var(--hero-gold);
    font-size: 18px;
    letter-spacing: 2px;
    margin-bottom: 15px;
  }

  .lxn-hero-title {
    color: var(--hero-gold);
    font-size: 42px;
    font-weight: 800;
    line-height: 1.1;
    margin: 0 0 25px 0;
    text-transform: uppercase;
    text-shadow: 0 4px 12px rgba(0,0,0,0.5);
  }

  .lxn-hero-cta {
    display: inline-block;
    background-color: var(--hero-gold);
    color: #000000;
    font-size: 16px;
    font-weight: 800;
    padding: 14px 32px;
    border-radius: 50px;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform 0.3s ease, background 0.3s ease;
    box-shadow: 0 6px 20px rgba(212, 162, 76, 0.3);
  }
  .lxn-hero-cta:hover {
    transform: translateY(-2px);
    background-color: #b88a3e;
  }

  /* Image Content */
  .lxn-hero-image-wrap {
    flex: 1;
    max-width: 450px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }
  .lxn-hero-image-wrap img {
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 15px 30px rgba(0,0,0,0.6));
  }
  /* Decoración circular de fondo imitando el stand del mockup */
  .lxn-hero-image-wrap::before {
    content: '';
    position: absolute;
    bottom: -20px;
    width: 80%;
    height: 40px;
    background: radial-gradient(ellipse at center, rgba(212, 162, 76, 0.2) 0%, transparent 70%);
    z-index: -1;
  }

  /* Mobile */
  @media screen and (max-width: 768px) {
    .lxn-hero-wrap {
      padding: 40px 15px;
    }
    .lxn-hero-inner {
      flex-direction: column;
      gap: 30px;
    }
    .lxn-hero-title {
      font-size: 32px;
    }
    .lxn-hero-image-wrap {
      max-width: 300px;
    }
  }

  /* Dots */
  .lxn-hero-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 30px;
  }
  .lxn-hero-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: rgba(212, 162, 76, 0.3);
    cursor: pointer;
    transition: background 0.3s ease;
  }
  .lxn-hero-dot.active {
    background-color: var(--hero-gold);
  }
{%- endstyle -%}

<div class="lxn-hero-wrap">
  <div class="lxn-hero-inner">
    
    <div class="lxn-hero-text-content">
      <div class="lxn-hero-stars">★★★★★</div>
      <h1 class="lxn-hero-title">PRODUCTOS<br>CUIDADO & BIENESTAR</h1>
      <a href="shopify://collections/all" class="lxn-hero-cta">COMPRAR AHORA</a>
    </div>

    <div class="lxn-hero-image-wrap">
      {%- if section.blocks.first.settings.image_desktop != blank -%}
        <img src="{{ section.blocks.first.settings.image_desktop | image_url: width: 600 }}" alt="Productos Luxen">
      {%- else -%}
        {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

  </div>
  
  <div class="lxn-hero-dots">
    <div class="lxn-hero-dot active"></div>
    <div class="lxn-hero-dot"></div>
    <div class="lxn-hero-dot"></div>
    <div class="lxn-hero-dot"></div>
  </div>
</div>

{% schema %}
{
  "name": "Hero LUXEN Premium",
  "class": "lxn-section-hero",
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Imagen del Producto"
        }
      ]
    }
  ]
}
{% endschema %}
