{%- style -%}
  .custom-footer-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.color_text }};
    padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    border-top: 1px solid rgba(15, 93, 90, 0.1);
  }

  @media screen and (min-width: 768px) {
    .custom-footer-{{ section.id }} {
      padding-left: 24px;
      padding-right: 24px;
      padding-top: {{ section.settings.padding_top | plus: 15 }}px;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 2 }}px;
    }
  }

  .custom-footer-{{ section.id }} .footer-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  @media screen and (min-width: 768px) {
    .custom-footer-{{ section.id }} .footer-grid {
      flex-direction: row;
      justify-content: space-between;
      gap: 40px;
    }
  }

  .custom-footer-{{ section.id }} .footer-col {
    flex: 1;
  }

  /* Specific column adjustments */
  @media screen and (min-width: 768px) {
    .custom-footer-{{ section.id }} .footer-col--contact {
      max-width: 300px;
    }
    .custom-footer-{{ section.id }} .footer-col--links {
      max-width: 250px;
    }
    .custom-footer-{{ section.id }} .footer-col--trust {
      max-width: 350px;
    }
  }

  .custom-footer-{{ section.id }} .footer-title {
    font-size: 15px;
    font-weight: 700;
    color: {{ section.settings.color_primary_teal }};
    margin: 0 0 16px 0;
    text-transform: uppercase;
    letter-spacing: 0.8px;
  }

  .custom-footer-{{ section.id }} .footer-text {
    font-size: 13.5px;
    line-height: 1.5;
    color: rgba(26, 31, 30, 0.8);
    margin: 0 0 12px 0;
  }

  .custom-footer-{{ section.id }} .footer-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .custom-footer-{{ section.id }} .footer-link {
    font-size: 13.5px;
    color: rgba(26, 31, 30, 0.8);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .custom-footer-{{ section.id }} .footer-link:hover {
    color: {{ section.settings.color_primary_teal }};
  }

  /* Contact specifics */
  .custom-footer-{{ section.id }} .contact-item {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
    font-size: 13.5px;
    color: rgba(26, 31, 30, 0.85);
  }

  .custom-footer-{{ section.id }} .contact-item svg {
    width: 18px;
    height: 18px;
    color: {{ section.settings.color_primary_teal }};
    flex-shrink: 0;
  }

  .custom-footer-{{ section.id }} .whatsapp-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: #25D366;
    color: #ffffff;
    padding: 10px 18px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 13px;
    text-decoration: none;
    margin-top: 6px;
    box-shadow: 0 4px 10px rgba(37, 211, 102, 0.2);
    transition: all 0.2s ease;
  }

  .custom-footer-{{ section.id }} .whatsapp-btn:hover {
    background-color: #20ba59;
    transform: translateY(-1px);
    box-shadow: 0 6px 14px rgba(37, 211, 102, 0.3);
  }

  /* Social Icons */
  .custom-footer-{{ section.id }} .social-icons-wrap {
    display: flex;
    gap: 12px;
    margin-top: 16px;
  }

  .custom-footer-{{ section.id }} .social-icon-link {
    color: {{ section.settings.color_primary_teal }};
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background-color: rgba(15, 93, 90, 0.05);
    border-radius: 50%;
    transition: all 0.2s ease;
  }

  .custom-footer-{{ section.id }} .social-icon-link:hover {
    background-color: {{ section.settings.color_primary_teal }};
    color: #ffffff;
    transform: translateY(-2px);
  }

  .custom-footer-{{ section.id }} .social-icon-link svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  /* Payment list & guarantee */
  .custom-footer-{{ section.id }} .payment-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  .custom-footer-{{ section.id }} .payment-badge-cod {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    background-color: {{ section.settings.color_primary_teal }};
    color: #ffffff;
    padding: 4px 8px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    letter-spacing: 0.5px;
  }

  .custom-footer-{{ section.id }} .payment-logo {
    height: 20px;
    width: auto;
    object-fit: contain;
    opacity: 0.85;
    background: #ffffff;
    border: 1px solid rgba(26, 31, 30, 0.08);
    border-radius: 4px;
    padding: 2px 6px;
  }

  /* Bottom line */
  .custom-footer-{{ section.id }} .footer-bottom {
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid rgba(15, 93, 90, 0.08);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
  }

  @media screen and (min-width: 768px) {
    .custom-footer-{{ section.id }} .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
      margin-top: 48px;
    }
  }

  .custom-footer-{{ section.id }} .copyright-text {
    font-size: 12px;
    color: rgba(26, 31, 30, 0.55);
    margin: 0;
  }
{%- endstyle -%}

<footer class="custom-footer-{{ section.id }}">
  <div class="footer-grid">
    
    <!-- COLUMN 1: CONTACT -->
    <div class="footer-col footer-col--contact">
      <h3 class="footer-title">{{ section.settings.contact_title | escape }}</h3>
      <p class="footer-text">{{ section.settings.contact_intro | escape }}</p>
      
      {%- if section.settings.phone != blank -%}
        <div class="contact-item">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span>{{ section.settings.phone | escape }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.email != blank -%}
        <div class="contact-item">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          <span>{{ section.settings.email | escape }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.hours != blank -%}
        <div class="contact-item">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
          <span>{{ section.settings.hours | escape }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.whatsapp_link != blank -%}
        <a href="{{ section.settings.whatsapp_link }}" class="whatsapp-btn" target="_blank" rel="noopener">
          <!-- WhatsApp Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.948h.003c4.368 0 7.927-3.558 7.929-7.928a7.86 7.86 0 0 0-2.324-5.594zm-5.6 11.233c-1.18 0-2.34-.316-3.35-.916l-.24-.143-2.483.65.663-2.42-.157-.25a6.602 6.602 0 0 1-1.01-3.6c.003-3.64 2.984-6.621 6.624-6.621 1.765 0 3.423.689 4.67 1.936a6.57 6.57 0 0 1 1.93 4.68c-.003 3.65-2.983 6.628-6.624 6.628z"/>
          </svg>
          {{ section.settings.whatsapp_label | escape }}
        </a>
      {%- endif -%}
    </div>

    <!-- COLUMN 2: POLICIES / LINKS -->
    <div class="footer-col footer-col--links">
      <h3 class="footer-title">{{ section.settings.links_title | escape }}</h3>
      <ul class="footer-links-list">
        {%- if section.settings.legal_menu != blank -%}
          {%- for link in section.settings.legal_menu.links -%}
            <li>
              <a href="{{ link.url }}" class="footer-link">{{ link.title | escape }}</a>
            </li>
          {%- endfor -%}
        {%- else -%}
          <!-- Auto fallbacks for standard policies -->
          <li><a href="/policies/refund-policy" class="footer-link">Política de Reembolso</a></li>
          <li><a href="/policies/shipping-policy" class="footer-link">Política de Envío</a></li>
          <li><a href="/policies/terms-of-service" class="footer-link">Términos del Servicio</a></li>
          <li><a href="/policies/privacy-policy" class="footer-link">Política de Privacidad</a></li>
        {%- endif -%}
      </ul>
    </div>

    <!-- COLUMN 3: TRUST & COD -->
    <div class="footer-col footer-col--trust">
      <h3 class="footer-title">{{ section.settings.trust_title | escape }}</h3>
      <p class="footer-text">{{ section.settings.trust_description | escape }}</p>
      
      <!-- Payments Accepted Icons -->
      <div class="payment-icons">
        <span class="payment-badge-cod">
          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          Contra Entrega (Efectivo)
        </span>
        <!-- General credit card and transfer logos for visual reassurance -->
        <span class="payment-badge-cod" style="background-color: #888888;">Visa / Master</span>
        <span class="payment-badge-cod" style="background-color: #888888;">Transferencia</span>
      </div>

      <!-- Social Networks -->
      <div class="social-icons-wrap">
        {%- if section.settings.social_instagram != blank -%}
          <a href="{{ section.settings.social_instagram }}" class="social-icon-link" target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 16 16"><path d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.917 3.917 0 0 0-1.417.923A3.927 3.927 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.916 3.916 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.926 3.926 0 0 0-.923-1.417A3.911 3.911 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0h.003zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599.28.28.453.546.598.92.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.47 2.47 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.478 2.478 0 0 1-.92-.598 2.48 2.48 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233 0-2.136.008-2.388.046-3.231.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92.28-.28.546-.453.92-.598.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045v.002zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92zm-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217zm0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334z"/></svg>
          </a>
        {%- endif -%}

        {%- if section.settings.social_tiktok != blank -%}
          <a href="{{ section.settings.social_tiktok }}" class="social-icon-link" target="_blank" rel="noopener" aria-label="TikTok">
            <svg viewBox="0 0 16 16"><path d="M9 0h1.98c.144.715.54 1.617 1.235 2.512C12.895 3.389 13.797 4 15 4v2c-1.753 0-3.07-.814-4-2.128V11a5.002 5.002 0 0 1-5 5c-2.757 0-5-2.243-5-5s2.243-5 5-5c.42 0 .822.052 1.205.152L7.205 8.14a3.003 3.003 0 0 0-2.205 2.86 3.003 3.003 0 0 0 3 3 3.003 3.003 0 0 0 3-3V0z"/></svg>
          </a>
        {%- endif -%}

        {%- if section.settings.social_facebook != blank -%}
          <a href="{{ section.settings.social_facebook }}" class="social-icon-link" target="_blank" rel="noopener" aria-label="Facebook">
            <svg viewBox="0 0 16 16"><path d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951z"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>

  </div>

  <!-- COPYRIGHT LINE -->
  <div class="footer-bottom">
    <p class="copyright-text">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Todos los derechos reservados.</p>
    <p class="copyright-text" style="opacity: 0.8;">Salud y Bienestar garantizados con envío seguro.</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer Minimalista",
  "class": "custom-footer-section",
  "settings": [
    {
      "type": "header",
      "content": "Columna 1: Contacto"
    },
    {
      "type": "text",
      "id": "contact_title",
      "label": "Título de Contacto",
      "default": "Soporte y Contacto"
    },
    {
      "type": "text",
      "id": "contact_intro",
      "label": "Texto introductorio",
      "default": "¿Tienes dudas con tu pedido? Escríbenos por WhatsApp."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Teléfono",
      "default": "+593 99 999 9999"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Correo Electrónico",
      "default": "soporte@luxenshop.com"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Horarios de Atención",
      "default": "Lunes a Sábado: 8:00 AM - 6:00 PM"
    },
    {
      "type": "url",
      "id": "whatsapp_link",
      "label": "Enlace a WhatsApp"
    },
    {
      "type": "text",
      "id": "whatsapp_label",
      "label": "Texto del botón WhatsApp",
      "default": "Chatear por WhatsApp"
    },
    {
      "type": "header",
      "content": "Columna 2: Políticas y Enlaces"
    },
    {
      "type": "text",
      "id": "links_title",
      "label": "Título de Enlaces",
      "default": "Políticas Legales"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Menú Legal (Opcional)",
      "info": "Si se deja en blanco, se generarán enlaces automáticos a las políticas estándar."
    },
    {
      "type": "header",
      "content": "Columna 3: Garantía y Confianza"
    },
    {
      "type": "text",
      "id": "trust_title",
      "label": "Título de Garantía",
      "default": "Paga al Recibir"
    },
    {
      "type": "textarea",
      "id": "trust_description",
      "label": "Descripción de Confianza",
      "default": "Ofrecemos pago contra entrega en todo Ecuador. Compra con total tranquilidad, pagas en efectivo cuando tu producto llega a tu puerta."
    },
    {
      "type": "header",
      "content": "Redes Sociales"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram Link"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok Link"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook Link"
    },
    {
      "type": "header",
      "content": "Ajustes de Diseño"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Relleno superior",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Relleno inferior",
      "default": 30
    },
    {
      "type": "header",
      "content": "Colores predeterminados"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo del Footer",
      "default": "#F4F9F8"
    },
    {
      "type": "color",
      "id": "color_primary_teal",
      "label": "Color Verde Azulado",
      "default": "#0F5D5A"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Color del Texto",
      "default": "#1A1F1E"
    }
  ],
  "presets": [
    {
      "name": "Footer Minimalista"
    }
  ]
}
{% endschema %}
