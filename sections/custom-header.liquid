{%- style -%}
  :root {
    --color-bg-dark: #0D0D0D;
    --color-gold: #D4A24C;
    --color-text-light: #FFFFFF;
  }

  .lxn-announcement-bar {
    background-color: var(--color-bg-dark);
    color: var(--color-gold);
    text-align: center;
    padding: 8px 20px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-bottom: 1px solid rgba(212, 162, 76, 0.15);
  }
  
  .lxn-header-wrapper {
    background-color: var(--color-bg-dark);
    padding: 12px 20px;
    position: sticky;
    top: 0;
    z-index: 999;
    box-shadow: 0 4px 20px rgba(0,0,0,0.5);
  }

  .lxn-header-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
  }

  /* Logo LUXEN con Rayo */
  .lxn-logo-container {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--color-text-light);
  }
  .lxn-logo-icon {
    color: var(--color-gold);
    margin-right: 6px;
    display: flex;
  }
  .lxn-logo-text {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  /* Buscador (Centered, White bg, Gold button) */
  .lxn-search-form {
    flex: 1;
    max-width: 500px;
    display: flex;
    background: #FFFFFF;
    border-radius: 4px;
    overflow: hidden;
    margin: 0 15px;
  }
  .lxn-search-input {
    flex: 1;
    border: none;
    background: transparent;
    padding: 10px 15px;
    font-size: 13px;
    color: #000;
    outline: none;
  }
  .lxn-search-input::placeholder {
    color: #666;
    font-style: italic;
  }
  .lxn-search-btn {
    background-color: var(--color-gold);
    border: none;
    padding: 0 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000;
    transition: background 0.2s ease;
  }
  .lxn-search-btn:hover {
    background-color: #b88a3e;
  }

  /* Íconos (User, Cart) */
  .lxn-header-icons {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .lxn-icon-link {
    color: var(--color-text-light);
    text-decoration: none;
    position: relative;
    display: flex;
    align-items: center;
    transition: color 0.2s ease;
  }
  .lxn-icon-link:hover {
    color: var(--color-gold);
  }
  .lxn-cart-count {
    position: absolute;
    top: -6px;
    right: -8px;
    background-color: var(--color-gold);
    color: #000;
    font-size: 10px;
    font-weight: 800;
    min-width: 16px;
    height: 16px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Mobile */
  @media screen and (max-width: 768px) {
    .lxn-header-inner {
      flex-wrap: wrap;
    }
    .lxn-search-form {
      order: 3;
      width: 100%;
      max-width: 100%;
      margin: 10px 0 0 0;
    }
  }
{%- endstyle -%}

<!-- Announcement Bar -->
{%- if section.settings.show_announcement -%}
  <div class="lxn-announcement-bar">
    {{ section.settings.announcement_text | escape }}
  </div>
{%- endif -%}

<!-- Header Main -->
<header class="lxn-header-wrapper">
  <div class="lxn-header-inner">
    
    <!-- Mobile Menu Toggle (Opcional, oculto en mockup pero necesario funcionalmente) -->
    <details-modal class="header__icon header__icon--menu header__icon--summary link focus-inset" id="Details-menu-drawer-container">
      <summary class="header__icon header__icon--menu header__icon--summary link focus-inset" aria-label="Menu" style="color:#fff; border:none; background:transparent;">
        <span>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </span>
      </summary>
    </details-modal>

    <!-- Logo con Rayo -->
    <a href="{{ routes.root_url }}" class="lxn-logo-container">
      <span class="lxn-logo-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
      </span>
      <span class="lxn-logo-text">LUXEN</span>
    </a>

    <!-- Buscador -->
    <form action="{{ routes.search_url }}" method="get" class="lxn-search-form" role="search">
      <input type="text" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.search_placeholder | escape }}" class="lxn-search-input">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="lxn-search-btn" aria-label="Buscar">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </button>
    </form>

    <!-- Iconos -->
    <div class="lxn-header-icons">
      {%- if shop.customer_accounts_enabled -%}
        <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="lxn-icon-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        </a>
      {%- endif -%}
      
      <a href="{{ routes.cart_url }}" class="lxn-icon-link" id="cart-icon-bubble">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
        {%- if cart != empty -%}
          <span class="lxn-cart-count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>

  </div>
</header>

{% schema %}
{
  "name": "Header LUXEN Lujo",
  "class": "lxn-section-header",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Mostrar anuncio superior",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Texto del anuncio",
      "default": "ENVÍOS RÁPIDOS A TODO ECUADOR | PAGO CONTRA ENTREGA"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Texto Buscador",
      "default": "Buscar productos..."
    }
  ]
}
{% endschema %}
