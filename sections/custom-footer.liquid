      gap: 10px;
      margin-bottom: 12px;
      font-size: 14px;
      color: #D1D5DB;
    }

    .custom-footer-{{ section.id }} .contact-icon {
      width: 18px;
      height: 18px;
      color: #E5A93C;
      flex-shrink: 0;
    }

    .custom-footer-{{ section.id }} .whatsapp-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background-color: #E5A93C;
      color: #000000;
      padding: 10px 18px;
      border-radius: 50px;
      font-weight: 800;
      text-decoration: none;
      font-size: 14px;
      transition: all 0.2s ease;
    }

    .custom-footer-{{ section.id }} .whatsapp-btn:hover {
      background-color: #b88a3e;
      transform: translateY(-2px);
    }

    .custom-footer-{{ section.id }} .whatsapp-btn svg {
      width: 18px;
      height: 18px;
