    "custom_testimonials": {
      "type": "custom-testimonials",
      "blocks": {
        "test_1": { "type": "review", "settings": { "stars": 5, "text": "El gel articular me alivió el dolor de rodillas en solo 3 días. El envío a Guayaquil fue rapidísimo y pagué contra entrega.",  "author_name": "María Belén S.", "verified_purchase": true } },
        "test_2": { "type": "review", "settings": { "stars": 5, "text": "Compré la crema de colágeno facial. La atención por WhatsApp fue muy amable y el producto me llegó al día siguiente.",           "author_name": "Carmen M.",       "verified_purchase": true } },
        "test_3": { "type": "review", "settings": { "stars": 5, "text": "El suplemento de magnesio llegó sellado y en perfecto estado. Pagué en efectivo al recibir. Excelente servicio.",              "author_name": "Luis G.",          "verified_purchase": true } }
      },
      "block_order": ["test_1","test_2","test_3"],
      "settings": {
        "title": "Lo que opinan nuestros clientes",
        "subtitle": "Más de 5,000 ecuatorianos confían en nosotros para su bienestar.",
        "text_alignment": "center",
        "desktop_columns": 3,
        "padding_top": 40,
        "padding_bottom": 40,
        "bg_color": "#ffffff",
        "color_bg_mint": "#F4F9F8",
        "color_primary_teal": "#0F5D5A",
        "color_text_dark": "#1A1F1E"
      }
    }
