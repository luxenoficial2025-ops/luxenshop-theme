{% comment %}
  Renders a custom product card.
  Accepts:
  - product: {Object} Product Liquid object
  - lazy_load: {Boolean} Image should be lazy loaded. Default: true
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign has_discount = false
  if product.compare_at_price > product.price
    assign has_discount = true
  endif
-%}

<div class="lxn-premium-card">
  <!-- Card Media Wrapper -->
  <div class="lxn-card-media">
    <!-- Flotante Badge -->
    <span class="lxn-badge-premium">
      {%- if has_discount -%}
        OFERTA ESPECIAL
      {%- else -%}
        ENVÍO GRATIS
      {%- endif -%}
    </span>

    <a href="{{ product.url }}" class="lxn-image-link" aria-label="Ver {{ product.title | escape }}">
      {%- if product.featured_media -%}
        <img
          src="{{ product.featured_media | image_url: width: 600, height: 750, crop: 'center' }}"
          alt="{{ product.featured_media.alt | default: product.title | escape }}"
          {% if lazy_load == false %}
            fetchpriority="high"
            loading="eager"
          {% else %}
            loading="lazy"
          {% endif %}
          width="400"
          height="500"
        >
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </a>
  </div>

  <!-- Content Area -->
  <div class="lxn-card-content">
    <!-- Product Title -->
    <h3 class="lxn-card-title">
      <a href="{{ product.url }}">
        {{ product.title | escape }}
      </a>
    </h3>

    <!-- Static Star Rating -->
    <div class="lxn-rating-wrap" aria-label="4.9 de 5 estrellas">
      <div class="lxn-stars">★★★★★</div>
      <span class="lxn-rating-count">(4.9)</span>
    </div>

    <!-- Price Section -->
    <div class="lxn-price-wrap">
      <span class="lxn-price-current">
        {{ product.price | money }}
      </span>
      {%- if has_discount -%}
        <span class="lxn-price-compare">
          {{ product.compare_at_price | money }}
        </span>
      {%- endif -%}
    </div>

    <!-- Quick Add Form -->
    {%- if product.available -%}
      {%- form 'product', product, class: 'lxn-add-form' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        
        <button 
          type="submit" 
          name="add" 
          class="lxn-add-btn"
          aria-label="Pedir Contra Entrega"
        >
          PEDIR CONTRA ENTREGA
        </button>
      {%- endform -%}
    {%- else -%}
      <button class="lxn-add-btn disabled" disabled>
        AGOTADO
      </button>
    {%- endif -%}
  </div>
</div>

<style>
.lxn-premium-card {
  display: flex;
  flex-direction: column;
  background-color: #FFFFFF;
  border-radius: 12px;
  border: 1px solid #E2E8F0;
  box-shadow: 0 4px 15px rgba(0,0,0,0.06);
  overflow: hidden;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  height: 100%;
}

.lxn-premium-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 25px rgba(0,0,0,0.1);
}

.lxn-card-media {
  position: relative;
  width: 100%;
  padding-top: 100%; /* 1:1 Aspect ratio */
  overflow: hidden;
  background: #F8FAFC;
}

@media screen and (min-width: 768px) {
  .lxn-card-media {
    padding-top: 125%; /* 4:5 Aspect ratio en desktop */
  }
}

.lxn-image-link {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: block;
}

.lxn-image-link img, .lxn-image-link svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.lxn-badge-premium {
  position: absolute;
  top: 10px;
  left: 10px;
  z-index: 2;
  background-color: #0B0B0C;
  color: #E5A93C;
  font-size: 11px;
  font-weight: 800;
  padding: 6px 10px;
  border-radius: 4px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  border: 1px solid #E5A93C;
}

.lxn-card-content {
  padding: 16px;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.lxn-card-title {
  margin: 0 0 8px;
  font-size: 15px;
  line-height: 1.3;
}

.lxn-card-title a {
  color: #111827;
  text-decoration: none;
  font-weight: 600;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.lxn-rating-wrap {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 12px;
}

.lxn-stars {
  color: #E5A93C;
  font-size: 14px;
  letter-spacing: 1px;
}

.lxn-rating-count {
  font-size: 12px;
  color: #64748B;
  font-weight: 500;
}

.lxn-price-wrap {
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: auto;
}

.lxn-price-current {
  font-size: 18px;
  font-weight: 800;
  color: #0B0B0C;
}

.lxn-price-compare {
  font-size: 14px;
  font-weight: 500;
  color: #94A3B8;
  text-decoration: line-through;
}

.lxn-add-form {
  margin: 0;
}

.lxn-add-btn {
  width: 100%;
  background-color: #E5A93C;
  color: #000000;
  border: none;
  border-radius: 6px;
  padding: 12px;
  font-size: 14px;
  font-weight: 800;
  cursor: pointer;
  text-transform: uppercase;
  transition: all 0.2s ease;
  display: flex;
  justify-content: center;
  align-items: center;
}

.lxn-add-btn:hover:not(.disabled) {
  background-color: #d4952b;
  transform: scale(1.02);
}

.lxn-add-btn.disabled {
  background-color: #E2E8F0;
  color: #94A3B8;
  cursor: not-allowed;
}
</style>
