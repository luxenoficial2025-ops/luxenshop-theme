{%- style -%}
  .lxn-trust-section {
    background-color: #0D0D0D;
    padding: 50px 20px;
    border-top: 1px solid rgba(212, 162, 76, 0.2);
    border-bottom: 1px solid rgba(212, 162, 76, 0.2);
  }
  .lxn-trust-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }
  
  /* Left Side: Big Shield + Main Text */
  .lxn-trust-main {
    display: flex;
    align-items: center;
    gap: 20px;
    flex: 1;
    min-width: 300px;
  }
  .lxn-trust-shield {
    color: #D4A24C;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lxn-trust-shield svg {
    width: 80px;
    height: 80px;
    filter: drop-shadow(0 0 15px rgba(212,162,76,0.4));
  }
  .lxn-trust-main-text {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .lxn-trust-main-text h3 {
    color: #D4A24C;
    font-size: 24px;
    font-weight: 900;
    margin: 0;
    line-height: 1.1;
    text-transform: uppercase;
  }
  .lxn-trust-main-text p {
    color: #FFFFFF;
    font-size: 18px;
    font-weight: 700;
    margin: 0;
    text-transform: uppercase;
  }

  /* Right Side: Circular Badges */
  .lxn-trust-badges {
    display: flex;
    flex-direction: column;
    gap: 15px;
    flex: 1;
    min-width: 250px;
  }
  .lxn-badge-item {
    display: flex;
    align-items: center;
    background: rgba(212, 162, 76, 0.1);
    border: 1px solid rgba(212, 162, 76, 0.3);
    border-radius: 50px;
    padding: 10px 20px;
    gap: 15px;
  }
  .lxn-badge-icon {
    background: #D4A24C;
    color: #000;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .lxn-badge-text {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
  }

  @media screen and (max-width: 768px) {
    .lxn-trust-inner { flex-direction: column; text-align: center; }
    .lxn-trust-main { flex-direction: column; }
    .lxn-trust-main-text h3 { font-size: 20px; }
    .lxn-trust-main-text p { font-size: 16px; }
  }
{%- endstyle -%}

<div class="lxn-trust-section">
  <div class="lxn-trust-inner">
    
    <div class="lxn-trust-main">
      <div class="lxn-trust-shield">
        <!-- Escudo con Rayo tipo Mockup -->
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" stroke="none">
          <path d="M12 2L3 6v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V6l-9-4zm-1 15l-3-4 1.41-1.41L11 14.17l5.59-5.59L18 10l-7 7z" opacity="0.3"></path>
          <path d="M12 2L3 6v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V6l-9-4zm1 14h-2v-4H8l5-8v4h3l-3 8z"></path>
        </svg>
      </div>
      <div class="lxn-trust-main-text">
        <h3>ENVÍO RÁPIDO & SEGURO</h3>
        <p>PAGO CONTRA ENTREGA</p>
      </div>
    </div>

    <div class="lxn-trust-badges">
      <div class="lxn-badge-item">
        <div class="lxn-badge-icon">✓</div>
        <div class="lxn-badge-text">GARANTÍA DE SATISFACCIÓN</div>
      </div>
      <div class="lxn-badge-item">
        <div class="lxn-badge-icon">📞</div>
        <div class="lxn-badge-text">SOPORTE 24/7 WHATSAPP</div>
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Confianza Premium",
  "class": "lxn-section-trust"
}
{% endschema %}
