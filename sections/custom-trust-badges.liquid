{%- style -%}
  .custom-trust-badges-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    border-top: 1px solid rgba(15, 93, 90, 0.08);
    border-bottom: 1px solid rgba(15, 93, 90, 0.08);
  }

  .custom-trust-badges-{{ section.id }} .badges-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  @media screen and (min-width: 768px) {
    .custom-trust-badges-{{ section.id }} .badges-container {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
  }

  .custom-trust-badges-{{ section.id }} .badge-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 16px;
    box-sizing: border-box;
  }

  @media screen and (min-width: 768px) {
    .custom-trust-badges-{{ section.id }} .badge-item {
      padding: 8px;
    }
  }

  .custom-trust-badges-{{ section.id }} .badge-icon-wrap {
    color: {{ section.settings.color_primary_teal }};
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .custom-trust-badges-{{ section.id }} .badge-item:hover .badge-icon-wrap {
    transform: scale(1.08);
  }

  .custom-trust-badges-{{ section.id }} .badge-icon-wrap svg {
    width: 36px;
    height: 36px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }

  @media screen and (min-width: 768px) {
    .custom-trust-badges-{{ section.id }} .badge-icon-wrap svg {
      width: 42px;
      height: 42px;
    }
  }

  .custom-trust-badges-{{ section.id }} .badge-title {
    font-size: 14px;
    font-weight: 700;
    color: {{ section.settings.color_text_dark }};
    margin: 0 0 6px 0;
    line-height: 1.3;
  }

  @media screen and (min-width: 768px) {
    .custom-trust-badges-{{ section.id }} .badge-title {
      font-size: 15px;
    }
  }

  .custom-trust-badges-{{ section.id }} .badge-description {
    font-size: 12px;
    color: rgba(26, 31, 30, 0.7);
    margin: 0;
    line-height: 1.4;
  }
{%- endstyle -%}

<div class="custom-trust-badges-{{ section.id }}">
  <div class="badges-container">
    {%- for block in section.blocks -%}
      <div class="badge-item" {{ block.shopify_attributes }}>
        <div class="badge-icon-wrap">
          {%- case block.type -%}
            {%- when 'cod_badge' -%}
              <!-- Hand holding cash/box COD -->
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="5" width="20" height="14" rx="2" ry="2" />
                <line x1="2" y1="10" x2="22" y2="10" />
                <path d="M6 14h2M10 14h4" />
                <circle cx="18" cy="14" r="1.5" />
              </svg>
            {%- when 'secure_badge' -%}
              <!-- Secure check (shield + lock) -->
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                <circle cx="12" cy="11" r="2" />
                <path d="M12 13v3" />
              </svg>
            {%- when 'shipping_badge' -%}
              <!-- Shipping truck -->
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="3" width="15" height="13" rx="2" ry="2" />
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8" />
                <circle cx="5.5" cy="18.5" r="2.5" />
                <circle cx="18.5" cy="18.5" r="2.5" />
              </svg>
            {%- when 'refund_badge' -%}
              <!-- Guarantee medal / return -->
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2a10 10 0 0 1 10 10c0 5.523-4.477 10-10 10S2 17.523 2 12A10 10 0 0 1 12 2z" />
                <path d="m9 12 2 2 4-4" />
              </svg>
            {%- else -%}
              <!-- Generic badge -->
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="16" x2="12" y2="12" />
                <line x1="12" y1="8" x2="12.01" y2="8" />
              </svg>
          {%- endcase -%}
        </div>
        <h3 class="badge-title">{{ block.settings.title | escape }}</h3>
        <p class="badge-description">{{ block.settings.description | escape }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Sellos de Confianza",
  "class": "custom-trust-badges-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Relleno superior",
      "default": 25
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Relleno inferior",
      "default": 25
    },
    {
      "type": "header",
      "content": "Paleta de Colores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo de la Sección",
      "default": "#F4F9F8"
    },
    {
      "type": "color",
      "id": "color_primary_teal",
      "label": "Color Verde Azulado (Íconos)",
      "default": "#0F5D5A"
    },
    {
      "type": "color",
      "id": "color_text_dark",
      "label": "Color de Títulos",
      "default": "#1A1F1E"
    }
  ],
  "blocks": [
    {
      "type": "cod_badge",
      "name": "Pago Contra Entrega",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título del Sello",
          "default": "Pago Contra Entrega"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Descripción corta",
          "default": "Paga en efectivo al recibir en la puerta de tu casa."
        }
      ]
    },
    {
      "type": "secure_badge",
      "name": "Compra Segura",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título del Sello",
          "default": "Compra 100% Segura"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Descripción corta",
          "default": "Tus datos personales están protegidos con encriptación SSL."
        }
      ]
    },
    {
      "type": "shipping_badge",
      "name": "Envío a todo el país",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título del Sello",
          "default": "Envío a todo el país"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Descripción corta",
          "default": "Entregas en todo el territorio con rastreo de pedido."
        }
      ]
    },
    {
      "type": "refund_badge",
      "name": "Devolución Garantizada",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título del Sello",
          "default": "Garantía de Devolución"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Descripción corta",
          "default": "Si tu producto llega dañado, te lo cambiamos sin costo."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sellos de Confianza",
      "blocks": [
        {
          "type": "cod_badge"
        },
        {
          "type": "secure_badge"
        },
        {
          "type": "shipping_badge"
        },
        {
          "type": "refund_badge"
        }
      ]
    }
  ]
}
{% endschema %}
