{%- style -%}
  .custom-categories-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .custom-categories-{{ section.id }} .section-title {
    font-size: 20px;
    font-weight: 700;
    color: {{ section.settings.color_text_dark }};
    margin: 0 0 16px 0;
    text-align: {{ section.settings.title_alignment }};
  }

  @media screen and (min-width: 768px) {
    .custom-categories-{{ section.id }} {
      padding-left: 24px;
      padding-right: 24px;
    }
    .custom-categories-{{ section.id }} .section-title {
      font-size: 26px;
      margin-bottom: 24px;
    }
  }

  .custom-categories-{{ section.id }} .categories-grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    gap: 16px;
    padding: 4px 4px 12px;
    -webkit-overflow-scrolling: touch;
  }

  /* Hide scrollbar for Chrome, Safari and Opera */
  .custom-categories-{{ section.id }} .categories-grid::-webkit-scrollbar {
    display: none;
  }

  /* Hide scrollbar for IE, Edge and Firefox */
  .custom-categories-{{ section.id }} .categories-grid {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  @media screen and (min-width: 768px) {
    .custom-categories-{{ section.id }} .categories-grid {
      display: grid;
      grid-template-columns: repeat({{ section.blocks.size | default: 6 }}, 1fr);
      gap: 24px;
      overflow-x: visible;
      padding: 0;
    }
  }

  .custom-categories-{{ section.id }} .category-item {
    flex: 0 0 calc(25% - 12px);
    min-width: 72px;
    text-align: center;
    scroll-snap-align: start;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  @media screen and (max-width: 480px) {
    .custom-categories-{{ section.id }} .category-item {
      flex: 0 0 calc(28% - 10px);
    }
  }

  @media screen and (min-width: 768px) {
    .custom-categories-{{ section.id }} .category-item {
      flex: none;
      min-width: auto;
    }
  }

  .custom-categories-{{ section.id }} .category-circle {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 2px solid rgba(15, 93, 90, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: all 0.25s ease-in-out;
    box-shadow: 0 4px 10px rgba(15, 93, 90, 0.04);
  }

  @media screen and (min-width: 768px) {
    .custom-categories-{{ section.id }} .category-circle {
      width: 100px;
      height: 100px;
    }
  }

  .custom-categories-{{ section.id }} .category-item:hover .category-circle {
    transform: scale(1.06);
    border-color: {{ section.settings.color_primary_teal }};
    box-shadow: 0 6px 14px rgba(15, 93, 90, 0.15);
  }

  .custom-categories-{{ section.id }} .category-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .custom-categories-{{ section.id }} .category-placeholder {
    width: 45%;
    height: 45%;
    color: {{ section.settings.color_primary_teal }};
    opacity: 0.8;
  }

  .custom-categories-{{ section.id }} .category-title {
    font-size: 12px;
    font-weight: 600;
    color: {{ section.settings.color_text_dark }};
    margin: 0;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    height: 2.6em; /* Holds exactly 2 lines height */
  }

  @media screen and (min-width: 768px) {
    .custom-categories-{{ section.id }} .category-title {
      font-size: 14px;
    }
  }

  .custom-categories-{{ section.id }} .category-item:hover .category-title {
    color: {{ section.settings.color_primary_teal }};
  }
{%- endstyle -%}

<div class="custom-categories-{{ section.id }} page-width">
  {%- if section.settings.title != blank -%}
    <h2 class="section-title">{{ section.settings.title | escape }}</h2>
  {%- endif -%}

  <div class="categories-grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="category-item" {{ block.shopify_attributes }}>
        <div class="category-circle">
          {%- if block.settings.image != blank -%}
            <img 
              src="{{ block.settings.image | image_url: width: 200, height: 200, crop: 'center' }}" 
              alt="{{ block.settings.title | escape }}"
              class="category-image"
              loading="lazy"
              width="100"
              height="100"
            >
          {%- else -%}
            <svg class="category-placeholder" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
          {%- endif -%}
        </div>
        <p class="category-title">{{ block.settings.title | escape }}</p>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Categorías Destacadas",
  "class": "custom-categories-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título de la Sección",
      "default": "Comprar por Categorías"
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Alineación del Título",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Relleno superior",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Relleno inferior",
      "default": 30
    },
    {
      "type": "header",
      "content": "Paleta de Colores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo de la Sección",
      "default": "#F4F9F8"
    },
    {
      "type": "color",
      "id": "color_primary_teal",
      "label": "Verde Azulado (Acento)",
      "default": "#0F5D5A"
    },
    {
      "type": "color",
      "id": "color_text_dark",
      "label": "Texto Oscuro",
      "default": "#1A1F1E"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen de la Categoría",
          "info": "Se recortará en círculo automáticamente."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Nombre de la Categoría",
          "default": "Nueva Categoría"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorías Destacadas",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Cuidado Articular"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Belleza Facial"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Suplementos"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Cuidado Personal"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Bienestar"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Ofertas"
          }
        }
      ]
    }
  ]
}
{% endschema %}
