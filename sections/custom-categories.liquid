{%- style -%}
  .lxn-cats-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  @media screen and (min-width: 768px) {
    .lxn-cats-{{ section.id }} { padding-left: 24px; padding-right: 24px; }
  }

  .lxn-cats-{{ section.id }} .lxn-cats-header {
    margin-bottom: 20px;
    text-align: {{ section.settings.title_alignment }};
  }

  .lxn-cats-{{ section.id }} .lxn-cats-title {
    font-size: 20px;
    font-weight: 800;
    color: {{ section.settings.color_text_dark }};
    margin: 0;
    line-height: 1.25;
  }

  @media screen and (min-width: 768px) {
    .lxn-cats-{{ section.id }} .lxn-cats-title { font-size: 26px; }
  }

  .lxn-cats-{{ section.id }} .lxn-cats-title em {
    color: {{ section.settings.color_primary_teal }};
    font-style: normal;
  }

  /* Grid */
  .lxn-cats-{{ section.id }} .lxn-cats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  @media screen and (min-width: 480px) {
    .lxn-cats-{{ section.id }} .lxn-cats-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (min-width: 768px) {
    .lxn-cats-{{ section.id }} .lxn-cats-grid {
      grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
      gap: 16px;
    }
  }

  /* Card */
  .lxn-cat-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    padding: 16px;
    min-height: 90px;
    position: relative;
    transition: transform .25s ease, box-shadow .25s ease;
  }

  @media screen and (min-width: 768px) {
    .lxn-cat-card { min-height: 110px; padding: 20px; }
  }

  .lxn-cat-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(26,31,30,.15);
  }

  .lxn-cat-card-text {
    flex: 1;
    min-width: 0;
    z-index: 1;
  }

  .lxn-cat-card-label {
    font-size: 13px;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 1px 3px rgba(0,0,0,.2);
  }

  @media screen and (min-width: 768px) {
    .lxn-cat-card-label { font-size: 15px; }
  }

  .lxn-cat-card-img-wrap {
    flex-shrink: 0;
    width: 60px;
    height: 60px;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,.15);
  }

  @media screen and (min-width: 768px) {
    .lxn-cat-card-img-wrap { width: 80px; height: 80px; }
  }

  .lxn-cat-card-img-wrap img {
    width: 100%; height: 100%;
    object-fit: cover;
  }

  .lxn-cat-card-placeholder {
    width: 60%;
    height: 60%;
    color: rgba(255,255,255,.7);
  }

  /* Preset card background colors */
  {% assign colors = "#1E7F70,#E76B39,#1E88E5,#7B3F9E,#C4A100,#2E7D32,#B33A3A,#00838F" | split: "," %}
  {% for block in section.blocks %}
    {% assign color_index = forloop.index0 | modulo: colors.size %}
    .lxn-cat-card[data-block="{{ block.id }}"] {
      background-color: {{ block.settings.card_color | default: colors[color_index] }};
    }
  {% endfor %}
{%- endstyle -%}

<div class="lxn-cats-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <div class="lxn-cats-header">
        <h2 class="lxn-cats-title">
          {{ section.settings.title_prefix | escape }}
          {%- if section.settings.title_highlight != blank -%}
            <em>{{ section.settings.title_highlight | escape }}</em>
          {%- endif -%}
          {{ section.settings.title_suffix | escape }}
        </h2>
      </div>
    {%- endif -%}

    <div class="lxn-cats-grid">
      {%- for block in section.blocks -%}
        <a
          href="{{ block.settings.link | default: '#' }}"
          class="lxn-cat-card"
          data-block="{{ block.id }}"
          {{ block.shopify_attributes }}
        >
          <div class="lxn-cat-card-text">
            <span class="lxn-cat-card-label">{{ block.settings.title | escape }}</span>
          </div>
          <div class="lxn-cat-card-img-wrap">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 200, height: 200, crop: 'center' }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                width="80"
                height="80"
              >
            {%- else -%}
              <svg class="lxn-cat-card-placeholder" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16v16H4zM4 9h16"/>
              </svg>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Categorías Destacadas",
  "class": "custom-categories-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "title_prefix",
      "label": "Texto antes del nombre destacado",
      "default": "Encuentra en"
    },
    {
      "type": "text",
      "id": "title_highlight",
      "label": "Nombre de la tienda (resaltado)",
      "default": "LuxenShop"
    },
    {
      "type": "text",
      "id": "title_suffix",
      "label": "Texto después del nombre destacado",
      "default": "todo lo que necesitas"
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Alineación del Título",
      "options": [
        { "value": "left",   "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Columnas en Escritorio",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Relleno superior",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Relleno inferior",
      "default": 24
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo de la Sección",
      "default": "#F4F9F8"
    },
    {
      "type": "color",
      "id": "color_primary_teal",
      "label": "Verde Azulado (Resaltado en Título)",
      "default": "#0F5D5A"
    },
    {
      "type": "color",
      "id": "color_text_dark",
      "label": "Texto Oscuro",
      "default": "#1A1F1E"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen del producto/categoría",
          "info": "Se mostrará a la derecha de la tarjeta."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Nombre de la Categoría",
          "default": "Cuidado Articular"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        },
        {
          "type": "color",
          "id": "card_color",
          "label": "Color de fondo de la tarjeta",
          "info": "Deja sin valor para usar el color automático de la secuencia."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorías Destacadas",
      "blocks": [
        { "type": "category", "settings": { "title": "Cuidado Articular" } },
        { "type": "category", "settings": { "title": "Belleza Facial" } },
        { "type": "category", "settings": { "title": "Suplementos" } },
        { "type": "category", "settings": { "title": "Cuidado Personal" } },
        { "type": "category", "settings": { "title": "Bienestar" } },
        { "type": "category", "settings": { "title": "Ofertas Especiales" } }
      ]
    }
  ]
}
{% endschema %}
