<div class="cro-trust-blocks" style="background-color: {{ section.settings.bg_color }};">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="cro-trust-blocks__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    
    <div class="cro-trust-blocks__grid">
      {%- for block in section.blocks -%}
        <div class="cro-trust-block" {{ block.shopify_attributes }}>
          <div class="cro-trust-block__icon">
            {%- if block.settings.icon != blank -%}
              {{ block.settings.icon }}
            {%- else -%}
              <!-- Default fallback icon -->
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            {%- endif -%}
          </div>
          <h3 class="cro-trust-block__heading">{{ block.settings.title | escape }}</h3>
          <p class="cro-trust-block__text">{{ block.settings.text | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CRO Trust Blocks",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título de la sección",
      "default": "Compra con Confianza"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#F9FAFB"
    }
  ],
  "blocks": [
    {
      "type": "trust_block",
      "name": "Bloque de Confianza",
      "settings": [
        {
          "type": "html",
          "id": "icon",
          "label": "SVG Icono o Emoji",
          "default": "🚚"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Envío a Todo Ecuador"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Descripción",
          "default": "Recibe tu pedido en la puerta de tu casa a nivel nacional."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CRO Trust Blocks",
      "blocks": [
        {
          "type": "trust_block",
          "settings": {
            "icon": "💵",
            "title": "Pago Contra Entrega",
            "text": "Pagas en efectivo al momento de recibir tu producto. 100% seguro."
          }
        },
        {
          "type": "trust_block",
          "settings": {
            "icon": "🚚",
            "title": "Envíos Rápidos",
            "text": "Despachamos tu pedido el mismo día. Cobertura a todo Ecuador."
          }
        },
        {
          "type": "trust_block",
          "settings": {
            "icon": "🛡️",
            "title": "Garantía de Satisfacción",
            "text": "Calidad premium asegurada o te devolvemos tu dinero."
          }
        }
      ]
    }
  ]
}
{% endschema %}
