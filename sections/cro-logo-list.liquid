<div class="cro-logo-list" style="background-color: {{ section.settings.bg_color }};">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h3 class="cro-logo-list__title">{{ section.settings.title | escape }}</h3>
    {%- endif -%}
    
    <div class="cro-logo-list__grid">
      {%- for block in section.blocks -%}
        <div class="cro-logo-list__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 200 }}" 
                 alt="{{ block.settings.image.alt | default: 'Courier Logo' }}" 
                 loading="lazy" 
                 class="cro-logo-list__image">
          {%- else -%}
            <div class="cro-logo-placeholder">Logo</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CRO Lista de Logos",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Envíos Seguros a Nivel Nacional"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "logo_image",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen del logo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CRO Lista de Logos",
      "blocks": [
        { "type": "logo_image" },
        { "type": "logo_image" },
        { "type": "logo_image" },
        { "type": "logo_image" }
      ]
    }
  ]
}
{% endschema %}
