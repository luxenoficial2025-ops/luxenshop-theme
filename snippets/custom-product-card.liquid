{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign has_discount = false
  if product.compare_at_price > product.price
    assign has_discount = true
  endif
-%}

<div class="lxn-card-premium">
  <div class="lxn-card-media">
    <a href="{{ product.url }}" class="lxn-image-link">
      {%- if product.featured_media -%}
        <img src="{{ product.featured_media | image_url: width: 600, height: 600, crop: 'center' }}" alt="{{ product.title | escape }}" loading="lazy">
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </a>
  </div>
  
  <div class="lxn-card-content">
    <h3 class="lxn-card-title">
      <a href="{{ product.url }}">{{ product.title | escape }}</a>
    </h3>
    
    <div class="lxn-rating-wrap">
      <div class="lxn-stars">★★★★★</div>
      <span class="lxn-rating-count">(4.9)</span>
    </div>
    
    <div class="lxn-price-wrap">
      <span class="lxn-price-current">{{ product.price | money }}</span>
      {%- if has_discount -%}
        <span class="lxn-price-compare">{{ product.compare_at_price | money }}</span>
      {%- endif -%}
    </div>
    
    {%- if product.available -%}
      {%- form 'product', product, class: 'lxn-add-form' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" name="add" class="lxn-add-btn">AÑADIR AL CARRITO</button>
      {%- endform -%}
    {%- else -%}
      <button class="lxn-add-btn disabled" disabled>AGOTADO</button>
    {%- endif -%}
  </div>
</div>

<style>
.lxn-card-premium {
  background-color: #FFFFFF;
  border-radius: 12px;
  border: 1px solid rgba(212, 162, 76, 0.4);
  box-shadow: 0 4px 15px rgba(212, 162, 76, 0.08);
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.lxn-card-premium:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 25px rgba(212, 162, 76, 0.15);
}
.lxn-card-media {
  position: relative;
  width: 100%;
  padding-top: 100%;
  background: #F8FAFC;
}
.lxn-image-link {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: block;
}
.lxn-image-link img, .lxn-image-link svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.lxn-card-content {
  padding: 16px;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}
.lxn-card-title {
  margin: 0 0 6px;
  font-size: 15px;
  line-height: 1.3;
}
.lxn-card-title a {
  color: #0D0D0D;
  text-decoration: none;
  font-weight: 700;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.lxn-rating-wrap {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-bottom: 10px;
}
.lxn-stars {
  color: #D4A24C;
  font-size: 14px;
  letter-spacing: 1px;
}
.lxn-rating-count {
  font-size: 12px;
  color: #64748B;
  font-weight: 500;
}
.lxn-price-wrap {
  margin-bottom: 15px;
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: auto;
}
.lxn-price-current {
  font-size: 18px;
  font-weight: 900;
  color: #0D0D0D;
}
.lxn-price-compare {
  font-size: 14px;
  font-weight: 500;
  color: #94A3B8;
  text-decoration: line-through;
}
.lxn-add-form {
  margin: 0;
}
.lxn-add-btn {
  width: 100%;
  background-color: #D4A24C;
  color: #000000;
  border: none;
  border-radius: 6px;
  padding: 12px;
  font-size: 13px;
  font-weight: 800;
  cursor: pointer;
  text-transform: uppercase;
  transition: background 0.2s ease;
}
.lxn-add-btn:hover:not(.disabled) {
  background-color: #b88a3e;
}
.lxn-add-btn.disabled {
  background-color: #E2E8F0;
  color: #94A3B8;
  cursor: not-allowed;
}
</style>
