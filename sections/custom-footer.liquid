    .custom-footer-{{ section.id }} .footer-container {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 40px;
    }

    .custom-footer-{{ section.id }} .footer-column {
      flex: 1;
      min-width: 250px;
    }
    
    .custom-footer-{{ section.id }} .footer-logo-wrap {
      margin-bottom: 20px;
    }
    .custom-footer-{{ section.id }} .footer-logo img {
      mix-blend-mode: screen;
    }

    .custom-footer-{{ section.id }} .footer-heading {
      font-size: 15px;
      font-weight: 800;
      color: #E5A93C;
      margin: 0 0 16px 0;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .custom-footer-{{ section.id }} .footer-text {
      font-size: 14px;
      line-height: 1.6;
      color: #D1D5DB;
      margin: 0 0 12px 0;
    }

    .custom-footer-{{ section.id }} .footer-link-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    
    .custom-footer-{{ section.id }} .footer-link-item {
      margin-bottom: 10px;
    }

    .custom-footer-{{ section.id }} .footer-link {
      font-size: 14px;
      color: #D1D5DB;
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .custom-footer-{{ section.id }} .footer-link:hover {
      color: #E5A93C;
    }

    .custom-footer-{{ section.id }} .contact-info {
      list-style: none;
