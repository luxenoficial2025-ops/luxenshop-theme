      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      background-color: rgba(229, 169, 60, 0.1);
      border-radius: 50%;
      transition: all 0.2s ease;
    }

    .custom-footer-{{ section.id }} .social-icon-link svg {
      width: 18px;
      height: 18px;
      fill: currentColor;
    }

    .custom-footer-{{ section.id }} .social-icon-link:hover {
      background-color: #E5A93C;
      color: #000000;
      transform: translateY(-2px);
    }

    .custom-footer-{{ section.id }} .trust-badge {
      display: inline-block;
